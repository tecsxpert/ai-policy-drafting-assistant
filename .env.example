# MySQL database connection URL
DB_URL=jdbc:mysql://localhost:3306/tooldb

# Database username
DB_USERNAME=root

# Database password
DB_PASSWORD=password


# Redis server host
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# SMTP mail server host
MAIL_HOST=smtp.gmail.com

# Email username for sending mails
MAIL_USERNAME=email

# Email password or app password
MAIL_PASSWORD=password

# Secret key for JWT authentication
JWT_SECRET=secretkey

# Docker / Compose specific variables (used by docker-compose.yml)
POSTGRES_DB=tool_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# AI service
AI_SERVICE_PORT=5000

# Hugging Face token (optional) to avoid unauthenticated HF Hub warnings
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Frontend
FRONTEND_PORT=5173